# ---------------------------------------------------------------------------
# Hypomonē @GRIT, contoh environment variable.
# Salin jadi .env.local untuk lokal; di Vercel isi lewat Project Settings →
# Environment Variables. JANGAN taruh nilai asli di berkas ini (ikut repo).
# ---------------------------------------------------------------------------

# --- Supabase (wajib di produksi) ---------------------------------------
# Supabase Dashboard → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
# "anon" / "publishable" key. Aman publik; data dijaga RLS (supabase/schema.sql).
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# "service_role" / "secret" key. RAHASIA. Hanya dipakai cron email untuk membaca
# checklist & keuangan. Kosong = email tetap terkirim tanpa bagian pribadi.
SUPABASE_SERVICE_ROLE_KEY=

# Satu-satunya akun yang boleh masuk. Samakan dengan owner_email() di schema.sql.
NEXT_PUBLIC_ALLOWED_EMAIL=lvnasandbox@gmail.com

# --- Email harian (Resend) ----------------------------------------------
RESEND_API_KEY=
# Tanpa domain terverifikasi, onboarding@resend.dev hanya bisa mengirim ke
# email yang terdaftar di akun Resend-mu.
NOTIFY_FROM="Hypomone <onboarding@resend.dev>"
# Penerima ringkasan. Kosong = NEXT_PUBLIC_ALLOWED_EMAIL.
NOTIFY_TO=
# Penjaga endpoint cron. String acak; Vercel mengirimnya sebagai Bearer token.
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CRON_SECRET=

# --- OCR struk dengan Claude (opsional) ---------------------------------
# Kosong = OCR berjalan di peramban dengan Tesseract.js (gratis, kurang akurat).
ANTHROPIC_API_KEY=

# --- URL situs (tombol di email & tautan masuk) -------------------------
NEXT_PUBLIC_SITE_URL=https://nama-proyekmu.vercel.app
