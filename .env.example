# ---------------------------------------------------------------------------
# Salin jadi .env.local untuk pengembangan lokal, lalu isi nilainya sendiri.
# Di Vercel: Project Settings -> Environment Variables.
#
# Berkas ini ikut masuk repositori, jadi JANGAN pernah menaruh nilai asli di
# sini. Yang asli hanya di .env.local (diabaikan git) dan di Vercel.
# ---------------------------------------------------------------------------

# --- Akun (satu-satunya user situs ini) ---
# Ketiganya WAJIB. Kalau ada yang kosong, login selalu ditolak.
AUTH_EMAIL=email-kamu@contoh.com
AUTH_PASSWORD=
# Kunci penanda tangan cookie sesi, minimal 16 karakter.
# Cara membuat: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=

# --- Notifikasi email ---
# API key dari https://resend.com (gratis 3.000 email/bulan).
RESEND_API_KEY=

# Alamat pengirim. Tanpa domain terverifikasi, pakai onboarding@resend.dev
# (hanya bisa mengirim ke email yang terdaftar di akun Resend-mu).
NOTIFY_FROM="Sandbox <onboarding@resend.dev>"

# Penerima ringkasan. Default mengikuti AUTH_EMAIL kalau dikosongkan.
NOTIFY_TO=

# Penjaga endpoint cron. String acak; Vercel mengirimnya sebagai Bearer token.
CRON_SECRET=

# --- URL situs (dipakai untuk tombol di dalam email) ---
NEXT_PUBLIC_SITE_URL=https://nama-proyekmu.vercel.app
